# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.

# --- Google / Gemini -------------------------------------------------------
# Required: API key for Gemini models (flash for cheap ops, pro for reasoning).
# SECURITY NOTE: this key ends up inside .env on disk, and the web-demo
# double-click launcher (see README "Web Demo") zips the whole project
# folder including .env when you package it to hand to someone. That's
# fine for sharing directly with a specific person (e.g. an interviewer)
# but never commit .env or publish that zip publicly — .gitignore already
# excludes .env from git, keep it that way.
GOOGLE_API_KEY=Your_GOOGLE_API_KEY

# Model names. Override here if we need to swap during development.
# Verified live against the Gemini API on 2026-09-14 — Google retires
# specific dated model names over time, so re-check with
# client.models.list() if these start 404ing again.
# Both flash and pro point at the same free-tier model for now: a real
# pro-tier model (e.g. gemini-3.1-pro-preview) needs billing enabled on
# the Google AI Studio project this key belongs to — the free tier's
# quota for pro-tier text generation is 0, not "limited". Swap
# GEMINI_MODEL_PRO once billing is on; no code changes needed either way.
GEMINI_MODEL_FLASH=gemini-3.1-flash-lite
GEMINI_MODEL_PRO=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Langfuse (observability) ---------------------------------------------
# Optional: if missing, the system falls back to local-only token logging.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Storage paths --------------------------------------------------------
# Relative to repo root. Both are inside the gitignored `data/` dir by default.
SQLITE_PATH=data/agent_system.sqlite
CHROMA_DIR=data/chroma
TOKEN_LOG_PATH=data/token_log.jsonl

# --- Thresholds -----------------------------------------------------------
# Max critic-synthesizer revision loops before we force exit.
MAX_REVISIONS=3
# Number of unsupported claims (an absolute count, not a fraction) at or
# above which the Critic requires a revision. Clamped to a minimum of 1
# by Critic.review() regardless of what's set here — even a single
# unsupported claim must not reach Final=True by default.
CRITIC_UNSUPPORTED_THRESHOLD=1
# Deterministic hard cap on the Orchestrator's research loop (Scout ->
# Analyst -> Evaluator -> replan?). 1 = no replanning (original
# single-shot behavior). 2 = at most one targeted replan round. The
# Evaluator decides IF/WHAT to search next; this caps HOW MANY rounds
# regardless of what it wants.
MAX_RESEARCH_ROUNDS=2
# Global cap on total *new unique* posts analyzed across every research
# round combined (duplicates never count against it). Without this,
# MAX_RESEARCH_ROUNDS rounds could each independently use their own
# max_posts budget and add up unboundedly.
MAX_TOTAL_POSTS=30

# --- Dev toggles ----------------------------------------------------------
# If set to "1", the prompt registry re-reads files on every call (hot reload).
DEV_MODE=0
